# ==============================================================================
# CONFIGURAÇÃO DE AMBIENTE - EVOLUTION API v2 & TYPEBOT (WARNAT TECH)
# ==============================================================================

# Porta exposta no Host para a Evolution API (ex: 8080 ou 8085 caso 8080 esteja em uso)
EVOLUTION_PORT=8080

# Versão da imagem Docker da Evolution API
EVOLUTION_VERSION=v2.3.7

# URL pública ou local da Evolution API (IP da VPS ou domínio com https://)
# Exemplo local: http://localhost:8080 | VPS: https://evolution.seudominio.com.br
SERVER_URL=http://localhost:8080

# Chave de API Global para autenticação de requisições na Evolution API
AUTHENTICATION_API_KEY=SUA_CHAVE_GLOBAL_AQUI_123456

# ==============================================================================
# BANCO DE DADOS POSTGRESQL
# ==============================================================================
POSTGRES_USER=evolution_user
POSTGRES_PASSWORD=sua_senha_forte_aqui
POSTGRES_DB=evolution_db
POSTGRES_PORT=5432

# ==============================================================================
# CONFIGURAÇÕES DA INSTÂNCIA WHATSAPP (WARNAT TECH)
# ==============================================================================
INSTANCE_NAME=warnat-tech
INSTANCE_TOKEN=token-interno-warnat-123
INTEGRATION=WHATSAPP-BAILEYS

# ==============================================================================
# INTEGRAÇÃO TYPEBOT
# ==============================================================================
# URL do Viewer do Typebot (Cloud: https://viewer.typebot.io ou seu Typebot auto-hospedado)
TYPEBOT_URL=https://viewer.typebot.io

# Slug ou ID público do bot criado no Typebot
TYPEBOT_NAME=warnat-atendimento-xyz

# Tempo de expiração da sessão inativa em minutos
TYPEBOT_EXPIRE=20

# Palavra-chave para o cliente ou atendente encerrar o fluxo do bot
TYPEBOT_KEYWORD_FINISH=#parar

# Delay de simulação de digitação em milissegundos
TYPEBOT_DELAY_MESSAGE=1500

# Agrupamento de mensagens recebidas em sequência (em segundos)
TYPEBOT_DEBOUNCE_TIME=10

# Mensagem enviada quando o Typebot não compreende a resposta
TYPEBOT_UNKNOWN_MESSAGE=Desculpe, não compreendi. Poderia repetir?

# ==============================================================================
# TRANSBORDO E NOTIFICAÇÃO (WHATSAPP PESSOAL / TÉCNICO)
# ==============================================================================
# Número que receberá os alertas de novos leads (DDI + DDD + Número)
# Exemplo: 5531999999999 (sem traços, pontos ou espaços)
NOTIFICATION_PHONE=5531999999999

# ==============================================================================
# PAINEL MULTI-TENANT (ADMINISTRAÇÃO)
# ==============================================================================
PANEL_PORT=3100
PANEL_ADMIN_PASSWORD=WarnatAdmin2026!
